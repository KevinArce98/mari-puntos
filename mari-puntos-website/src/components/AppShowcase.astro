---
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const shot = (name: string) => `/${name}${lang === 'en' ? '-en' : ''}.png`;

const pills = [
  { icon: '🎯', label: t('showcase.pill1') },
  { icon: '🤝', label: t('showcase.pill2') },
  { icon: '🔥', label: t('showcase.pill3') },
  { icon: '⚔️', label: t('showcase.pill4') },
  { icon: '🔔', label: t('showcase.pill5') },
];
---

<section class="relative overflow-hidden py-20 md:py-32 bg-[#071a17]">
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-175 h-125 bg-primary/20 rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute top-1/4 left-1/3 w-75 h-75 bg-purple-600/10 rounded-full blur-[80px]"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/3 w-62.5 h-62.5 bg-primary/12 rounded-full blur-[70px]"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(var(--primary) 1px, transparent 1px), linear-gradient(to right, var(--primary) 1px, transparent 1px); background-size: 48px 48px;"
    >
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 md:mb-20">
      <span
        class="inline-block px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary text-xs font-semibold uppercase tracking-widest mb-4"
      >
        {t('showcase.eyebrow')}
      </span>
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-4 leading-tight">
        {t('showcase.title1')}
        <span
          class="text-transparent bg-clip-text bg-linear-to-r from-primary to-[#5EEAD4]"
        >
          {t('showcase.titleHighlight')}
        </span>
      </h2>
      <p class="text-gray-400 text-lg max-w-lg mx-auto">
        {t('showcase.subtitle')}
      </p>
    </div>

    <div class="relative flex items-end justify-center h-120 md:h-145">
      <div
        class="absolute hidden md:block"
        style="left: calc(50% - 300px); bottom: 24px; transform: rotate(-11deg); z-index: 1;"
      >
        <div
          class="absolute -top-5 -left-12 z-10 bg-white rounded-2xl px-3.5 py-2.5 shadow-2xl flex items-center gap-2.5 whitespace-nowrap"
        >
          <div
            class="w-8 h-8 rounded-xl bg-yellow-400/20 flex items-center justify-center text-base shrink-0"
          >
            🏆
          </div>
          <div>
            <p class="text-xs font-bold text-gray-900 leading-none mb-0.5">
              {t('showcase.badge1.points')}
            </p>
            <p class="text-[10px] text-gray-500">{t('showcase.badge1.label')}</p>
          </div>
        </div>
        <div class="w-47" style="width: 188px">
          <div class="bg-gray-900 rounded-[2.8rem] p-0.75 shadow-[0_32px_80px_rgba(0,0,0,0.6)]">
            <div class="bg-[#1a1a1a] rounded-[2.75rem] p-0.75">
              <div class="bg-black rounded-[2.5rem] overflow-hidden">
                <img src={shot('actions')} alt={t('showcase.screenActions')} class="w-full object-cover block" />
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-gray-500 text-xs mt-3 font-medium tracking-wide uppercase">
          {t('showcase.screenActions')}
        </p>
      </div>

      <div class="relative z-10">
        <div class="absolute -inset-10 -z-10 bg-primary/20 rounded-full blur-[60px]"></div>
        <div
          class="absolute -inset-0.75 -z-10 rounded-[3.2rem] bg-linear-to-b from-primary/40 to-transparent"
        >
        </div>
        <div style="width: 248px">
          <div class="bg-gray-900 rounded-[2.8rem] p-0.75 shadow-[0_32px_80px_rgba(0,0,0,0.6)]">
            <div class="bg-[#1a1a1a] rounded-[2.75rem] p-0.75">
              <div class="bg-black rounded-[2.5rem] overflow-hidden">
                <img src={shot('home')} alt={t('showcase.screenHome')} class="w-full object-cover block" />
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-primary text-xs mt-3 font-semibold tracking-wide uppercase">
          {t('showcase.screenHome')}
        </p>
      </div>

      <div
        class="absolute hidden md:block"
        style="right: calc(50% - 300px); bottom: 24px; transform: rotate(11deg); z-index: 1;"
      >
        <div
          class="absolute -top-5 -right-12 z-10 bg-white rounded-2xl px-3.5 py-2.5 shadow-2xl flex items-center gap-2.5 whitespace-nowrap"
        >
          <div
            class="w-8 h-8 rounded-xl bg-primary/20 flex items-center justify-center text-base shrink-0"
          >
            ⚔️
          </div>
          <div>
            <p class="text-xs font-bold text-gray-900 leading-none mb-0.5">
              María vs Kevin
            </p>
            <p class="text-[10px] text-gray-500">{t('showcase.badge2.label')}</p>
          </div>
        </div>
        <div style="width: 188px">
          <div class="bg-gray-900 rounded-[2.8rem] p-0.75 shadow-[0_32px_80px_rgba(0,0,0,0.6)]">
            <div class="bg-[#1a1a1a] rounded-[2.75rem] p-0.75">
              <div class="bg-black rounded-[2.5rem] overflow-hidden">
                <img src={shot('duelo')} alt={t('showcase.screenDuel')} class="w-full object-cover block" />
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-gray-500 text-xs mt-3 font-medium tracking-wide uppercase">
          {t('showcase.screenDuel')}
        </p>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-2.5 mt-14">
      {
        pills.map((f) => (
          <div class="flex items-center gap-2 px-4 py-2 bg-white/8 backdrop-blur-sm rounded-full border border-white/12 hover:bg-white/14 transition-colors">
            <span class="text-sm">{f.icon}</span>
            <span class="text-gray-300 text-sm font-medium">{f.label}</span>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
      <a
        href="https://apps.apple.com/app/id6758923865"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-6 py-3.5 bg-white text-gray-900 rounded-2xl font-semibold text-sm hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-xl shadow-black/30"
      >
        <img
          src="/apple.svg"
          alt="Apple"
          class="w-6 h-6 shrink-0"
          style="filter: brightness(0)"
        />
        {t('store.appStore')}
      </a>
      <a
        href="https://play.google.com/store/apps/details?id=com.maripuntos.app"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-6 py-3.5 bg-white text-gray-900 rounded-2xl font-semibold text-sm hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-xl shadow-black/30"
      >
        <img src="/googleplay.svg" alt="Google Play" class="w-6 h-6 shrink-0" />
        {t('store.googlePlay')}
      </a>
    </div>
  </div>
</section>
