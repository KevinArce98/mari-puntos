---
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  lastUpdated: string;
  lang?: Lang;
  switchPath?: string;
}

const { title, lastUpdated, lang = 'es', switchPath = '/' } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'en' ? '/en/' : '/';
---

<div class="min-h-screen bg-white">
  <header class="bg-[#0F766E] text-white py-6 shadow-lg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-4">
        <a
          href={homeHref}
          class="inline-flex items-center text-white hover:text-gray-100 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width={2}
              d="M15 19l-7-7 7-7"
            ></path>
          </svg>
          {t('legal.backHome')}
        </a>
        <LanguageSwitcher lang={lang} path={switchPath} variant="dark" />
      </div>
      <h1 class="text-3xl md:text-4xl font-bold">{title}</h1>
      <p class="text-white/80 mt-2">{t('legal.lastUpdated')} {lastUpdated}</p>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </main>

  <footer class="bg-gray-900 text-white py-8 mt-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gray-400">{t('footer.rights')}</p>
    </div>
  </footer>
</div>
