# Environment
NODE_ENV=development

# Server
PORT=3000

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Dashboard -> API keys -> Show JWT public key -> PEM Public Key
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Dashboard -> Webhooks -> add endpoint https://your-api/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# App Configuration
PARTNER_CODE_LENGTH=6
POINTS_PER_LEVEL=100

# CORS (production only, comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
